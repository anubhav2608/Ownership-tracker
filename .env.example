# Copy to .env.local and fill in. Never commit real values.
# Leave the Supabase values empty to run the app as a demo on sample data.

# Supabase project settings → API (or `npx supabase status` for local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Used later by the inbound-email webhook and import worker,
# which act on behalf of users. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Fallback origin for auth redirects when a request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domain for users' forwarding addresses (u_<token>@<domain>), set up in Resend.
INBOUND_EMAIL_DOMAIN=in.example.com

# Google sign-in for the local Supabase stack (supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
