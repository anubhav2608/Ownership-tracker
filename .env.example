# Copy to .env.local and fill in. Never commit real values.
# Leave the Supabase values empty to run the app as a demo on sample data.

# Supabase project settings → API (or `npx supabase status` for local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Used by the inbound-email webhook, which acts for users who
# aren't signed in. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Fallback origin for auth redirects when a request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domain for users' forwarding addresses (u_<token>@<domain>): your Resend
# receiving domain.
INBOUND_EMAIL_DOMAIN=in.example.com

# Resend (server only): an API key that can read received emails, and the
# signing secret of the webhook pointing at /api/inbound/resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Google sign-in for the local Supabase stack (supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
